  "components": {
    "schemas": {
      "SentBody": {
        "required": [
          "revision"
        ],
        "type": "object",
        "properties": {
          "revision": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "RequestBodyDto": {
        "required": [
          "direction",
          "pointLat",
          "pointLon",
          "pointName"
        ],
        "type": "object",
        "properties": {
          "direction": {
            "type": "string",
            "enum": [
              "FROM_HUB",
              "TO_SCHOOL"
            ]
          },
          "hubId": {
            "type": "integer",
            "format": "int64"
          },
          "windowStart": {
            "type": "string",
            "format": "date-time"
          },
          "windowEnd": {
            "type": "string",
            "format": "date-time"
          },
          "arriveBy": {
            "type": "string",
            "format": "date-time"
          },
          "pointName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "pointLat": {
            "maximum": 90,
            "exclusiveMaximum": false,
            "minimum": -90,
            "exclusiveMinimum": false,
            "type": "number",
            "format": "double"
          },
          "pointLon": {
            "maximum": 180,
            "exclusiveMaximum": false,
            "minimum": -180,
            "exclusiveMinimum": false,
            "type": "number",
            "format": "double"
          },
          "memo": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "Preview": {
        "type": "object",
        "properties": {
          "soloFare": {
            "type": "integer",
            "format": "int64"
          },
          "soloMinutes": {
            "type": "integer",
            "format": "int32"
          },
          "resultBy": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SampleBody": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "MatchOutcome": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "WAITING",
              "MATCHED",
              "COMPLETED",
              "UNMATCHED",
              "CANCELED"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      },
      "AdvanceBody": {
        "required": [
          "minutes"
        ],
        "type": "object",
        "properties": {
          "minutes": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ProfileBody": {
        "required": [
          "gender",
          "nickname"
        ],
        "type": "object",
        "properties": {
          "nickname": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string"
          },
          "gender": {
            "type": "string",
            "enum": [
              "FEMALE",
              "MALE"
            ]
          }
        }
      },
      "LoginBody": {
        "required": [
          "code",
          "email"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "CodeBody": {
        "required": [
          "email"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        }
      },
      "SchoolView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "gateName": {
            "type": "string"
          },
          "lat": {
            "type": "number",
            "format": "double"
          },
          "lon": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "MemberView": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "integer",
            "format": "int64"
          },
          "memberId": {
            "type": "integer",
            "format": "int64"
          },
          "nickname": {
            "type": "string"
          },
          "memo": {
            "type": "string"
          },
          "rideOrder": {
            "type": "integer",
            "format": "int32"
          },
          "pointName": {
            "type": "string"
          },
          "expectedShare": {
            "type": "integer",
            "format": "int64"
          },
          "arrived": {
            "type": "boolean"
          },
          "noShow": {
            "type": "boolean"
          },
          "soloFare": {
            "type": "integer",
            "format": "int64"
          },
          "soloSeconds": {
            "type": "integer",
            "format": "int32"
          },
          "sharedSeconds": {
            "type": "integer",
            "format": "int32"
          },
          "boardAt": {
            "type": "string",
            "format": "date-time"
          },
          "arriveDeadline": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PartyView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "direction": {
            "type": "string",
            "enum": [
              "FROM_HUB",
              "TO_SCHOOL"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "CONFIRMED",
              "SETTLING",
              "COMPLETED",
              "UNSETTLED",
              "CANCELED"
            ]
          },
          "anchorName": {
            "type": "string"
          },
          "meetingPoint": {
            "type": "string"
          },
          "departureAt": {
            "type": "string",
            "format": "date-time"
          },
          "boardedAt": {
            "type": "string",
            "format": "date-time"
          },
          "myBoardAt": {
            "type": "string",
            "format": "date-time"
          },
          "arrivalAt": {
            "type": "string",
            "format": "date-time"
          },
          "callAt": {
            "type": "string",
            "format": "date-time"
          },
          "arriveDeadline": {
            "type": "string",
            "format": "date-time"
          },
          "expectedTotal": {
            "type": "integer",
            "format": "int64"
          },
          "soloTotal": {
            "type": "integer",
            "format": "int64"
          },
          "payerId": {
            "type": "integer",
            "format": "int64"
          },
          "payerNickname": {
            "type": "string"
          },
          "payer": {
            "type": "boolean"
          },
          "canArrive": {
            "type": "boolean"
          },
          "canBoard": {
            "type": "boolean"
          },
          "canCancel": {
            "type": "boolean"
          },
