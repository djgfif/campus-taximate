<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <property name="PATTERN" value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%X{requestId:-}] %logger{36} : %msg%n"/>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>${PATTERN}</pattern></encoder>
  </appender>
  <root level="INFO"><appender-ref ref="CONSOLE"/></root>

  <!-- SPRING_PROFILES_ACTIVE에 logfile을 넣으면 LOG_DIR에 날짜별 파일을 14일 남긴다. -->
  <springProfile name="logfile">
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
      <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
        <fileNamePattern>${LOG_DIR:-logs}/taximate.%d{yyyy-MM-dd}.log</fileNamePattern>
        <maxHistory>14</maxHistory>
      </rollingPolicy>
      <encoder><pattern>${PATTERN}</pattern></encoder>
    </appender>
    <root level="INFO"><appender-ref ref="FILE"/></root>
  </springProfile>
</configuration>
