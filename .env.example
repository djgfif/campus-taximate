# 복사해서 .env로 저장한다. .env는 Git에 올리지 않는다.

# 카카오모빌리티 길찾기 (필수)
KAKAO_REST_KEY=
# 카카오맵 JavaScript 키. 화면 빌드 때 들어간다. 콘솔에 사이트 도메인을 등록해야 한다.
VITE_KAKAO_JS_KEY=

# 계좌 암호화와 로그인 코드 해시에 쓴다 (운영 필수, 충분히 긴 임의 값)
ACCOUNT_KEY=

# 메일 (운영 필수)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.ac.kr

# 웹 푸시 키 (비우면 푸시 없이 메일만). 만들기: npx web-push generate-vapid-keys
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_SUBJECT=mailto:noreply@example.ac.kr

# 데이터베이스
DB_URL=jdbc:mysql://localhost:3306/taximate?serverTimezone=UTC&characterEncoding=UTF-8
DB_USER=taximate
DB_PASSWORD=

# 메일 링크의 주소이자 쓰기 요청을 허용할 주소
PUBLIC_URL=http://localhost:8080
# HTTPS가 아닌 로컬에서 운영 설정을 돌릴 때만 false로 둔다
COOKIE_SECURE=true
UPLOAD_DIR=./uploads
RATE_LIMIT_ENABLED=true
# API 문서(/swagger-ui.html)를 열 때 true
API_DOCS_ENABLED=false
